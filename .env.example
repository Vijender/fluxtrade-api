# Copy to backend/.env (optional). PYTHONPATH must be the repo root when running uvicorn.

# --- Postgres ---
# DATABASE_URL=postgresql://user:pass@host:5432/dbname

# HTTPS: redirect + HSTS (auto on Render when RENDER=true). Disable if needed:
# FLUXTRADE_DISABLE_HTTPS_REDIRECT=1
# FLUXTRADE_ENFORCE_HTTPS=1
# FLUXTRADE_HSTS_MAX_AGE=31536000

# JWT (sub + email claims)
FLUXTRADE_JWT_SECRET=
# FLUXTRADE_JWT_EXPIRE_HOURS=168

# Alert rows in ``alerts`` table: retention 2–5 days
# FLUXTRADE_ALERT_RETENTION_DAYS=5

# Optional: cache full scan JSON in ``scan_results`` (ticker + mode, TTL)
# FLUXTRADE_SCAN_CACHE_ENABLED=1
# FLUXTRADE_SCAN_CACHE_TTL_SECONDS=900

# Fernet key for user SMTP password encryption
FLUXTRADE_CREDENTIALS_FERNET_KEY=

# Global SMTP fallback
FLUXTRADE_SMTP_HOST=smtp.example.com
FLUXTRADE_SMTP_PORT=587
FLUXTRADE_SMTP_USER=
FLUXTRADE_SMTP_PASSWORD=
FLUXTRADE_SMTP_FROM=

FLUXTRADE_ALERT_BATCH_SECRET=change-me
# FLUXTRADE_DISABLE_ALERT_SCHEDULER=1
# FLUXTRADE_ALERT_BATCH_RUN_ON_STARTUP=1
